# Copy this file to .env and fill in what you need. .env is git-ignored: never commit real keys.

# Database (required): Supabase -> your project -> Connect -> "Session pooler" connection string,
# with [YOUR-PASSWORD] replaced by the database password
SUPABASE_DB_URL=

# Voice assistant: set ONE of these
# Free key: https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=
# Paid key: https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=
# Force a provider when both keys are set (default: claude)
# VOICE_PROVIDER=gemini
# VOICE_MODEL=gemini-3.5-flash

# Optional
# PORT=3000
# GST_API_KEY=
# MANAGEMENT_EMAIL=management@invocing.local
# MANAGEMENT_PASSWORD=manage123
# SEED_DEMO=0
