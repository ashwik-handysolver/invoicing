{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "{supabase/schema.sql,server/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/p/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/recurring", "schedule": "0 1 * * *" }
  ]
}
